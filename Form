<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor appointment form</title>
</head>
<body>
<h1>My Doctor Appoinmtent</h1>  
<p>Fill in the form below to book an appointment</p>  
<hr>
<form action="">
    <fieldset>
        <legend>Personal Details</legend>
        <label for="">Your name</label> <br>
        <input type="text" id="name" placeholder="Enter your full name"><br><br>
        <label for="">Patiend ID</label><br>
        <input type="password" id="pid" placeholder="Your secret ID"><br><br>
        <label for="">Date of birth</label><br>
        <input type="date" id="dob"><br>
    </fieldset>
    <br>
    <fieldset>
        <legend>Your visit</legend>
        <label for="">choose your doctor</label><br>
        <select name="" id="Doctor">
            <option value="Plan">select a doctor</option>
            <option value="dr-ray">Dr. Ray - General --</option>
            <option value="dr-lee">Dr.Lee - Teeth</option>
            <option value="Dt, sam">Dr. Sam - eyes</option>
            
        </select>
        <br><br>
        <label for="Why are you visiting"></label>
        <br>
        <input type="radio"> Fever <br>
        <input type="radio"> Cold <br>
        <input type="radio"> check up <br>
        <input type="radio"> tooth pain <br>
        <label for="">Any notes for the doctor</label> <br> =
        <textarea name="" id="notes" rows ="3" cols 
        "35"></textarea> <br>
        

    </fieldset>
    <br>
    <input type="submit" value="Book my appointment">
</form>
</body>
</html
